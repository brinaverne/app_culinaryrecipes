<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.MainActivity"
    android:padding="40dp"
    android:orientation="vertical"
    android:background="@color/amarelopastel">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Livro de Receitas"
        style="@style/titleFontStyle"/>

    <ImageView
        android:layout_width="230dp"
        android:layout_height="348dp"
        android:src="@drawable/amassa_v2"
        android:layout_gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="O Segredo  Nunca Foi o Amor,"
        style="@style/textFontStyle"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Mas sim o Ódio!"
        style="@style/textFontStyle"/>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:text="@string/activity_main_entrar"
        android:layout_marginTop="22dp"
        android:id="@+id/btntlinicial"
        style="@style/buttonTextFontStyle"
        app:shapeAppearance="@style/roundedButtonShape"
        android:backgroundTint="@color/roxopastel"
        />

</LinearLayout>